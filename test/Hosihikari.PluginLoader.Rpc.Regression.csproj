<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../Plugin.Abstractions/src/*.cs" Link="Abstractions/%(Filename)%(Extension)"
             Condition="Exists('../../Plugin.Abstractions/src')" />
    <Compile Include="../../Abstractions/src/*.cs" Link="Abstractions/%(Filename)%(Extension)"
             Condition="!Exists('../../Plugin.Abstractions/src')" />
    <Compile Include="../src/RpcConnection.cs" Link="RpcConnection.cs" />
  </ItemGroup>
</Project>
